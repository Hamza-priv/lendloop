# ---------------------------------------------------------------------------
# Next.js (.env.local)  — `npx convex dev` writes the two Convex lines for you
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ---------------------------------------------------------------------------
# Convex deployment variables — set with `npx convex env set NAME value`
# (they live in Convex, not in any file)
# ---------------------------------------------------------------------------
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
# ADMIN_EMAILS=you@example.com
# N8N_LOAN_EVENTS_WEBHOOK_URL=http://127.0.0.1:5678/webhook/lendloop-loan-events
# WEBHOOK_SECRET_TO_N8N=<same value as below>
# WEBHOOK_SECRET_FROM_N8N=<same value as below>

# ---------------------------------------------------------------------------
# docker-compose / n8n (.env) — generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=
WEBHOOK_SECRET_TO_N8N=
WEBHOOK_SECRET_FROM_N8N=
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211
