{
  "id": "LLoverdue0000001",
  "name": "LendLoop - Daily overdue reminders",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "LLerrors00000001",
    "saveManualExecutions": true
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "6a3cf725-2982-486b-9fb1-e49aba645e0b",
      "name": "Every day at 09:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {},
      "id": "ed0ee208-491a-4fe9-a524-b691717e7be9",
      "name": "Run now (testing)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Signs a JSON body for Convex: HMAC-SHA256 over \"<timestamp>.<body>\".\nconst crypto = require('crypto');\nfunction signed(payload) {\n  const body = JSON.stringify(payload);\n  const timestamp = Math.floor(Date.now() / 1000).toString();\n  const signature = 'sha256=' + crypto\n    .createHmac('sha256', $env.LENDLOOP_SECRET_TO_CONVEX)\n    .update(timestamp + '.' + body)\n    .digest('hex');\n  return { body, timestamp, signature };\n}\nreturn [{ json: signed({ requestId: $execution.id }) }];"
      },
      "id": "5735d897-d2c6-44e9-a682-41408f3d46df",
      "name": "Sign overdue request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/overdue-loans",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "2beadf83-6edf-4e7d-ad6a-da3f34f90c45",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One item per overdue loan. No items means nothing else runs.\nconst loans = $input.first().json.loans || [];\nreturn loans.map((loan) => ({ json: loan }));"
      },
      "id": "994dd0af-1cbd-403d-ac95-64d9551d21bc",
      "name": "One item per loan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Mock reminder channel: writes to the n8n log. Uses only name, email, tool and date.\nconst l = $json;\nconsole.log(`[LendLoop reminder] to=${l.borrower.email} ${l.borrower.name}, the ${l.tool.name} was due back on ${l.endDate} (${l.daysOverdue} day(s) ago). Please return it.`);\nreturn { json: { loanId: l.loanId, idempotencyKey: l.idempotencyKey, status: 'sent', channel: 'mock-log' } };"
      },
      "id": "f81425e4-50fb-451f-b2e3-e62fb02d6257",
      "name": "Send reminder (mock)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Signs a JSON body for Convex: HMAC-SHA256 over \"<timestamp>.<body>\".\nconst crypto = require('crypto');\nfunction signed(payload) {\n  const body = JSON.stringify(payload);\n  const timestamp = Math.floor(Date.now() / 1000).toString();\n  const signature = 'sha256=' + crypto\n    .createHmac('sha256', $env.LENDLOOP_SECRET_TO_CONVEX)\n    .update(timestamp + '.' + body)\n    .digest('hex');\n  return { body, timestamp, signature };\n}\n// The idempotencyKey (loanId + date) makes this safe to retry: Convex stores it once.\nreturn { json: signed({ ...$json, executionId: $execution.id }) };"
      },
      "id": "a16f2693-4820-488d-a2ac-584e2e2014cd",
      "name": "Sign write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/reminders",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "1597fbd4-d7f6-46fe-9ef6-5341cccc5b91",
      "name": "Record reminder in Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Every day at 09:00 UTC": {
      "main": [
        [
          {
            "node": "Sign overdue request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now (testing)": {
      "main": [
        [
          {
            "node": "Sign overdue request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign overdue request": {
      "main": [
        [
          {
            "node": "Fetch overdue loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch overdue loans": {
      "main": [
        [
          {
            "node": "One item per loan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per loan": {
      "main": [
        [
          {
            "node": "Send reminder (mock)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send reminder (mock)": {
      "main": [
        [
          {
            "node": "Sign write-back",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign write-back": {
      "main": [
        [
          {
            "node": "Record reminder in Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
